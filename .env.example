# Скопируйте в .env и заполните. Файл .env не публикуйте.
# Имя переменной с префиксом сервиса: AUTH__... уходит только сервису auth.

# Вход через Telegram: создайте бота у @BotFather (/newbot) и вставьте его токен
AUTH__TELEGRAM_BOT_TOKEN=

# Вход по почте: SMTP любого ящика (Gmail / Яндекс / Mail.ru — пароль приложения)
AUTH__SMTP_HOST=smtp.gmail.com
AUTH__SMTP_PORT=465
AUTH__SMTP_USER=
AUTH__SMTP_PASS=
AUTH__SMTP_FROM=

# Для разработки без почты: код входа показывается прямо на сайте
AUTH__DEV_LOGIN_CODES=0

# Адрес сайта (для ссылок в превью и SEO), при публикации — свой домен
PUBLIC_URL=http://127.0.0.1:8024

# Только для сервера (docker-compose.prod.yml): домен для HTTPS
DOMAIN=

# Ссылка на zip с шаблонами и медиа в Google Drive (для services/catalog/tools/fetch-content.js)
CONTENT_URL=

# --- Vercel (временно, см. README «Vercel (временно)») ---
# Там переменные задаются в настройках проекта Vercel, без префиксов сервисов; здесь — для справки.
# Без них сайт работает как на VPS: SQLite, файлы на диске, бот через long-polling.
# DATABASE_URL=postgres://...          # Neon Postgres из Marketplace (одна база на все сервисы)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...  # хранилище Vercel Blob для фото альбомов
# PORT=3000
# PUBLIC_URL=https://<адрес сайта>
# COOKIE_SECURE=1
# TELEGRAM_BOT_TOKEN=                  # тот же бот нельзя одновременно запускать локально
# CONTENT_URL=                         # нужна при сборке catalog (Dockerfile.vercel)
# SITE_NAME=Шақыру
# DEFAULT_LANG=kz
# CONTACT_WHATSAPP=
# PAYMENT_DETAILS=
