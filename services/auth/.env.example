PORT=8036
HOST=127.0.0.1
DB_FILE=./data/auth.db
# postgres://… (Neon) — Postgres вместо SQLite (на Vercel; общая база всех сервисов)
DATABASE_URL=
# 1 — cookie sid только по HTTPS (на боевом сайте)
COOKIE_SECURE=0

# Почта (вход по коду). Порт 465 — сразу TLS, 587 — STARTTLS. SMTP_SECURE=1 — принудительно TLS на другом порту.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Шақыру <no-reply@example.kz>
# 1 — без SMTP код возвращается в ответе /api/auth/email/start как dev_code (ТОЛЬКО для разработки)
DEV_LOGIN_CODES=0

# Telegram-бот от @BotFather (вход и уведомления). TELEGRAM_API_URL — только для локального Bot API/тестов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Webhook вместо long-polling: 1 — включить (на Vercel включён всегда). Адрес — TELEGRAM_WEBHOOK_URL,
# иначе PUBLIC_URL + /api/auth/telegram/webhook (только https). Секрет (A-Z a-z 0-9 _ -) — если пусто, выводится из токена.
TELEGRAM_WEBHOOK=0
TELEGRAM_WEBHOOK_URL=
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
